void zadanie1(void)
{
    char c = '!';
    int i = 2;
    float f = 3.14f;
    double d = 5e-12;

    puts("=== Задание 1 ===");
    printf("Начальные значения: c = %c, i = %d, f = %f, d = %e\n", c, i, f, d);

    puts("Введите символ:");
    scanf(" %c", &c);
    puts("Введите целое число:");
    scanf("%d", &i);
    puts("Введите вещественное число (float):");
    scanf("%f", &f);
    puts("Введите вещественное число (double):");
    scanf("%lf", &d);

    printf("Введены значения: c = %c, i = %d, f = %f, d = %e\n", c, i, f, d);
    puts("");
}

void zadacha1a(void)
{
