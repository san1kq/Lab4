void zadanie2_6(void)
{
    int a = 11, b = 3;

    puts("=== Задание 2, пункт 6: явное приведение типа ===");
    printf("(float)a / b      = %f\n", (float)a / b);
    printf("(double)a / b     = %f\n", (double)a / b);
    printf("(float)(a / b)    = %f\n", (float)(a / b));
    printf("(double)(a / b)   = %f\n", (double)(a / b));
    printf("float,  15 знаков = %.15f\n", (float)a / b);
    printf("double, 15 знаков = %.15f\n", (double)a / b);
    puts("");
}

void zadanie3(void)
{
    int n, a;

    puts("=== Задание 3 ===");
    printf("Введите трёхзначное число: ");
    scanf("%d", &n);

    a = n < 0 ? -n : n;
    if (a < 100 || a > 999)
    {
        puts("Это число не трёхзначное");
        puts("");
        return;
    }

    printf("Последняя цифра %d, первая - %d, сумма цифр %d, число наоборот - %03d\n",
        a % 10, a / 100, a / 100 + a / 10 % 10 + a % 10, a % 10 * 100 + a / 10 % 10 * 10 + a / 100);
    puts("");
}

void homework(void)
{
    int A, B;
    int left;

    puts("=== Домашнее задание === Вариант 9 ===");
    printf("Введите два целых числа от датчиков traffic flow (A и B): ");
    scanf("%d %d", &A, &B);

    left = (A % 2 == 0 && B % 2 != 0) || (A % 2 != 0 && B % 2 == 0);

    printf("Показать направление \"Налево\" (1 - да, 0 - нет): %d\n", left);
    if (left)
    {
        puts("Знак показывает направление \"Налево\"");
    }
    else
    {
        puts("Знак не показывает направление \"Налево\"");
    }
    puts("");
}

